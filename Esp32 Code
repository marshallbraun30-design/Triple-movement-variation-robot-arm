#include <cmath>
#include <Servo.h>
#include <Liquidcrystal.h>
#include <kepad.h>


int l1 = 30;
int l2 = 20;
int l3 = 20;
int phi = 90;
int pie = 3.1415;


// Lcd screen 
const int rs = 23;
const int en =5;
const int d4 = 17;
const int d5 = 16;
const int d6 = 4;
const int d7 = 2;

Liquidcrystal lcd(rs,en,d4,d5,d6,d7);

// Matrix keypad
const byte row = 4;
const byte col = 3;
const int r1 =

char keys[row][col] = 
{
	{'1','2','3'},
	{'4','5','6'},
	{'7','8','9'},
	{'*','0','#'}
};

byte rowpin[row] = {13,14,25,26};
byte colpin[col] = {27,32,33};

keypad keypad = keypad(makekeymap(keys),rowpin,colpin,row,col);


servo shoulder;
servo wrist;
servo elbow;
servo base;


void setup()
{
	shoulder.attach(18);
	elbow.attach(19);
	wrist.attach(21);
	base.attach(22);
	lcd.begin(16,2);
}

void update()
{
	/* 1-get coordinates 2-test if there valid and in range 3-if not in range call coordinates till valid. 
	4-send values to movement function which will move machine
	*/
	int ang1 = 90;
	int ang2 = 90;
	int ang3 = 90;

	int xvalue=0;
	int yvalue=0;
	int zvalue=0;

	while(true)
	{
		Inputvalues();
		AngCalculation(xvalue,yvalue,zvalue);
		if ( fwdtest(ang1,ang2,ang3))
		{
			ArmMovement(ang1,ang2,ang3);
			break;
		}

	}


	
	
}

void Inputvalues() //This function is done
{	
	/* 
	this funtion will take in no values. its sole purpose is to coordinate with the input interface and get the 
	users target (x,y,z) coordinates. 
	*/

	lcd.setcursor(0,0)
	
	while(true)
	{
		lcd.print("Enter x value :");
		char key = keypad.getkey();
		if (key>= '0' && key<='9')
		{
			xvalue = xvalue*10 + key;
			lcd.setcursor(0,1;);
			lcd.print(xvalue);
		}
		if (key =='*')
		{
			xvalue = 0;
			lcd.setcursor(0,1);
			lcd.print("  ");
			lcd.setcursor(0,1);
		}
		if (key == '#')
		{
			lcd.clear()
			break;
		}
	}
	while(true)
	{
		lcd.print("Enter Y value :");
		char key = keypad.getkey();
		if (key>= '0' && key<='9')
		{
			yvalue = yvalue*10 + key;
			lcd.print(yvalue);
		}
		if (key =='*')
		{
			yvalue = 0;
			lcd.clear();
		}
		if (key == '#')
		{
			lcd.clear();
			break;
		}
	}
	while(true)
	{
		lcd.print("Enter Z value :");
		char key = keypad.getkey();
		if (key>= '0' && key<='9')
		{
			zvalue = zvalue*10 + key;
			lcd.print(zvalue);
		}
		if (key =='*')
		{
			lcd.clear();
		}
		if (key == '#')
		{
			lcd.clear();
			break;
		}
	}

}

bool fwdtest(int ang1, int ang2, int ang3, int x, int y) //This function is done
{
	/* This function will take in the inverse kinematics values and check forward kinematics to make sure its all proper.
	it will also make sure that the position is within the machines limits. it will return a boolean value.*/
	minangle = 10;
	maxangle = 170;
	
	float rad1 = ang1*pie/180;
	float rad2 = ang2*pie/180;
	float rad3 = ang3*pie/180;

	if (maxangle > ang1 && ang1> minangle && maxangle > ang2 && ang2 > minangle && maxangle > ang3 && ang3 > minangle)
		{
		Xtarget = l1*cos(rad1) + l2*cos(rad1+rad2) + l3*cos(rad1+rad2+rad3);
		Ytarget = l1*sin(rad1) + l2*sin(rad1+rad2) + l3*sin(rad1+rad2+rad3);
		if (Xtarget==x && Ytarget ==y)
			{
				return true;
			}
		return false;
		}
	else
	{
		return false;
	}	
}

void AngCalculation(int targX, int targY, int targz) //This function is done
{
	/*
	
	This function serves the purpose of doing the inverse 
	kinematic proces to find the needed angles 
	to reach the desired point. it takes in the desired 
	position then gives the needed angles. It doesnt adjust 
	using current angle. that will be done elsewhere. 

	
	*/
	

	wristX = targX - l3 * cos(phi);
	wristY = targY - l3 * sin(phi);

	first = wristX *wristX + wristY*wristY + l1*l1 - l2*l2;
	second = 2 * l1 * sqrt(wristX*wristX + wristY*wristY);

	third = l1*l1 + l2*l2 - wristX*wristX - wristY*wristY;
	fourth = 2 * l1 * l2;

	ang1 = atan(wristY / wristX) - acos(first / second);
	ang2 = 1.571 - acos(third / fourth);

	ang3 = atan2(targz,targx);
}

void ArmMovement(int ang1, int ang2, int ang3) // this function is done for now. 
{
	/* 
	This function moves the robot arm
	*/
	shoulder.write(ang1);
	elbow.write(ang2);
	wrist.write(ang3);
}

