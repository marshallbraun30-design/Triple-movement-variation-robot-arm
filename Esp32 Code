	wristY = targY - l3 * sin(phi);

	first = wristX ^ 2 + wristY ^ 2 + l1 ^ 2 - l2 ^ 2
	second = 2 * l1 * (wristX ^ 2 + wristY ^ 2) ^ 0.5

